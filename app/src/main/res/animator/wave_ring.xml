<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
    <!-- Reset the tail at the start of every run. -->
    <objectAnimator android:propertyName="trimPathStart" android:valueType="floatType"
        android:valueFrom="0" android:valueTo="0" android:duration="0" />
    <objectAnimator android:propertyName="trimPathEnd" android:valueType="floatType"
        android:valueFrom="0" android:valueTo="1" android:duration="800"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
    <objectAnimator android:propertyName="trimPathStart" android:valueType="floatType"
        android:valueFrom="0" android:valueTo="1" android:startOffset="1100" android:duration="700"
        android:interpolator="@android:interpolator/fast_out_linear_in" />
</set>
